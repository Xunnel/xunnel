<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <t t-name="account_xunnel.no_token">
        <section class="__css_paybook_widget__ py-5 my-4 text-center">
            <h6 class="text-center text-muted mt-5">Press (esc) to close</h6>
        </section>
    </t>
    <t t-name="account_xunnel.add_account_manager">
        <section class="__css_paybook_widget__ py-5 my-4 text-center" t-ref="mainXunnelContainer">
            <div class="__css_paybook_widget_container__">
            </div>
            <img src="/web/content/account_xunnel.no_content_tree_view" alt="Logo" class="mx-auto logo-xunnel" />
            <div class="js_xunnel_dynamic_content">
                <t t-if="state.loading">
                    <h4 class="text-center text-muted mt-5"> <i class="fa fa-spin fa-spinner" /> loading...</h4>
                </t>
                <t t-else="">
                    <button
                        t-on-click.stop="() => this.openManager()"
                        class="btn btn-link text-center text-muted mt-5"
                    >Click to start</button>
                </t>
            </div>
        </section>
    </t>
    <t t-name="account_xunnel.synchronized_accounts_template">
        <div t-attf-class="alert alert-#{props.action.params.message_class} mb-0 py-4">
            <p
                t-attf-class="mt8 mb8 ml8 text-#{props.action.params.message_class}"
                t-esc="props.action.params.message"
            />
        </div>
    </t>
    <t t-name="account_xunnel.synchronized_accounts_footer">
        <div>
            <button class="btn btn-primary js_cancel pull-right">Ok</button>
        </div>
    </t>

</templates>
